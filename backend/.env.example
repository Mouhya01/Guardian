# --- Server ---
PORT=3000
NODE_ENV=development
# Enable Node.js cluster mode to fork one worker per CPU core (recommended in production)
CLUSTERING_ENABLED=false
# Comma-separated list of origins allowed to call this API (the Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- Google Gemini Flash API ---
# Paste your key from https://aistudio.google.com/apikey below — required before running an audit.
GEMINI_API_KEY=""
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest
# Per-call timeout and retry budget for the Gemini API request
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

# --- Global rate limiting (all routes) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Audit endpoint (multi-file upload + AI analysis) ---
# Stricter limiter dedicated to /audit — this route triggers a paid Gemini call per request.
AUDIT_RATE_LIMIT_WINDOW_MS=900000
AUDIT_RATE_LIMIT_MAX_REQUESTS=10
# Per-file and aggregate upload limits, in bytes
AUDIT_MAX_FILE_SIZE_BYTES=2097152
AUDIT_MAX_FILES_PER_REQUEST=50
AUDIT_MAX_TOTAL_PAYLOAD_BYTES=20971520

# --- MongoDB (audit history persistence + Better Auth storage) ---
# Connection string to your MongoDB instance/cluster — required for the app to start.
MONGODB_URI=""

# --- Better Auth ---
# Long random string used to sign sessions/tokens — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
# This API's own base URL (not the frontend's) — used by Better Auth for cookies/callbacks.
BETTER_AUTH_URL=http://localhost:3000
